# Copy to .env and fill these values. Never commit populated secrets.
TABULARIS_PUBLIC_ORIGIN=https://db.example.com
TABULARIS_ALLOWED_ORIGINS=https://db.example.com
TABULARIS_DB_USER=tabularis
TABULARIS_DB_NAME=tabularis
TABULARIS_DB_PASSWORD=

TABULARIS_OIDC_ISSUER_URL=https://identity.example.com
TABULARIS_OIDC_CLIENT_ID=
TABULARIS_OIDC_CLIENT_SECRET=
TABULARIS_OIDC_REDIRECT_URI=https://db.example.com/api/v1/auth/callback

# Run openssl rand -base64 32 separately for each key.
TABULARIS_JWT_SECRET=
TABULARIS_MASTER_KEY=
TABULARIS_MASTER_KEY_VERSION=1
# Optional JSON object, for example {"1":"<previous-base64-key>"}, when rotating to version 2.
TABULARIS_HISTORICAL_MASTER_KEYS=
