# Use the deployable HTTP backend instead of Tauri IPC or the browser preview shim.
VITE_TABULARIS_BACKEND_MODE=http

# Leave empty for same-origin deployments. Set an HTTPS origin only when the
# frontend and API are intentionally hosted separately.
VITE_TABULARIS_API_BASE_URL=

# Server-side settings. Keep the client secret out of Vite-prefixed variables.
TABULARIS_ENVIRONMENT=development
TABULARIS_METADATA_DATABASE_URL=postgres://tabularis:tabularis@127.0.0.1:5432/tabularis
TABULARIS_SESSION_TTL_SECONDS=28800
TABULARIS_OIDC_ISSUER_URL=
TABULARIS_OIDC_CLIENT_ID=
TABULARIS_OIDC_CLIENT_SECRET=
TABULARIS_OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
